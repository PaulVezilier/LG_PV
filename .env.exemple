# Copiez ce fichier en .env et remplacez les mots de passe (.env n'est jamais versionné).
# Mot de passe du superutilisateur « postgres » : sert uniquement à l'administration.
POSTGRES_PASSWORD=a-remplacer
# Mot de passe de « lg_app », l'utilisateur de l'application (à reporter dans ConnectionStrings:LG).
LG_APP_PASSWORD=a-remplacer
# Connexion à pgAdmin (http://localhost:5050) ; l'adresse ne sert que d'identifiant, aucun e-mail n'est envoyé.
PGADMIN_EMAIL=admin@loupgarou.fr
PGADMIN_PASSWORD=a-remplacer
